# ===========================================================================
# makefile.targets — User-managed additions — NOT overwritten by CubeIDE
#
# CubeMX stripped ThreadX, NetXDuo, BSP, CMSIS and most HAL driver sources
# from the auto-generated Debug/makefile when X-CUBE-AI/NPU was added.
# This file restores them permanently.
#
# Make is invoked from Debug/, so all relative paths below are relative
# to Debug/ (same as the other auto-generated subdir.mk files).
#
# IMPORTANT — spaces in OBJS paths:
#   GNU make splits variable values on whitespace during $(foreach) iteration.
#   The CubeIDE subdir.mk files for "Addons DHCP Client", "Ethernet Interface",
#   "LAN8742 Phy Interface" and "NX Core" put objects into spaced paths, which
#   corrupts OBJS iteration and breaks objects.list generation.
#   Those four subdir.mk files are NOT included here; we compile those sources
#   ourselves into space-free output directories instead.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) subdir.mk files whose OBJS contain NO spaces — safe to include directly
# ---------------------------------------------------------------------------
-include Middlewares/threadx/Core/subdir.mk
-include Drivers/BSP/Components/subdir.mk
-include Drivers/CMSIS/subdir.mk

# ---------------------------------------------------------------------------
# 2) NetXDuo — compile to space-free output directories
# ---------------------------------------------------------------------------
NX_REPO := ../../../Middlewares/ST/netxduo

# --- NX Core (hundreds of .c files in common/src/) ---
NXCORE_SRC_DIR := $(NX_REPO)/common/src
NXCORE_OBJ_DIR := Middlewares/netxduo/NXCore
NXCORE_SRCS    := $(wildcard $(NXCORE_SRC_DIR)/*.c)
NXCORE_OBJS    := $(patsubst $(NXCORE_SRC_DIR)/%.c,$(NXCORE_OBJ_DIR)/%.o,$(NXCORE_SRCS))

# --- DHCP addon (2 files) ---
DHCP_SRC_DIR := $(NX_REPO)/addons/dhcp
DHCP_OBJ_DIR := Middlewares/netxduo/DHCPClient
DHCP_OBJS    := \
  $(DHCP_OBJ_DIR)/nxd_dhcp_client.o \
  $(DHCP_OBJ_DIR)/nxd_dhcpv6_client.o

# --- Ethernet driver (1 file) ---
ETH_SRC_DIR := $(NX_REPO)/common/drivers/ethernet
ETH_OBJ_DIR := Middlewares/netxduo/EthernetIface
ETH_OBJS    := $(ETH_OBJ_DIR)/nx_stm32_eth_driver.o

# --- LAN8742 PHY driver (1 file) ---
LAN_SRC_DIR := $(NX_REPO)/common/drivers/ethernet/lan8742
LAN_OBJ_DIR := Middlewares/netxduo/LAN8742Phy
LAN_OBJS    := $(LAN_OBJ_DIR)/nx_stm32_phy_driver.o

# --- TSN shaper (1 file — nx_shaper_hw_queue_id_get referenced by eth driver) ---
TSN_SRC_DIR := $(NX_REPO)/tsn/src
TSN_OBJ_DIR := Middlewares/netxduo/TSN
TSN_OBJS    := $(TSN_OBJ_DIR)/nx_shaper.o

OBJS += $(NXCORE_OBJS) $(DHCP_OBJS) $(ETH_OBJS) $(LAN_OBJS) $(TSN_OBJS)

$(NXCORE_OBJ_DIR)/%.o: $(NXCORE_SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	arm-none-eabi-gcc "$<" $(ATON_CFLAGS) -MF"$(@:.o=.d)" -MT"$@" -c -o "$@"

$(DHCP_OBJ_DIR)/%.o: $(DHCP_SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	arm-none-eabi-gcc "$<" $(ATON_CFLAGS) -MF"$(@:.o=.d)" -MT"$@" -c -o "$@"

$(ETH_OBJ_DIR)/%.o: $(ETH_SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	arm-none-eabi-gcc "$<" $(ATON_CFLAGS) -MF"$(@:.o=.d)" -MT"$@" -c -o "$@"

$(LAN_OBJ_DIR)/%.o: $(LAN_SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	arm-none-eabi-gcc "$<" $(ATON_CFLAGS) -MF"$(@:.o=.d)" -MT"$@" -c -o "$@"

$(TSN_OBJ_DIR)/%.o: $(TSN_SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	arm-none-eabi-gcc "$<" $(ATON_CFLAGS) -MF"$(@:.o=.d)" -MT"$@" -c -o "$@"

# ---------------------------------------------------------------------------
# 3) Full HAL driver sources (17 files removed from Drivers/.../subdir.mk)
#    cacheaxi / i2c / i2c_ex are compiled from the physical project files
#    (already in the auto-generated subdir.mk); the rest come from the repo.
# ---------------------------------------------------------------------------
HAL_REPO_SRC := ../../../Drivers/STM32N6xx_HAL_Driver/Src
HAL_OBJ_OUT  := Drivers/STM32N6xx_HAL_Driver

OBJS += \
  $(HAL_OBJ_OUT)/stm32n6xx_hal.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_cortex.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_dma.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_dma_ex.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_eth.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_eth_ex.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_exti.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_gpio.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_pwr.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_pwr_ex.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_rcc.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_rcc_ex.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_rif.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_tim.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_tim_ex.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_uart.o \
  $(HAL_OBJ_OUT)/stm32n6xx_hal_uart_ex.o

$(HAL_OBJ_OUT)/%.o: $(HAL_REPO_SRC)/%.c
	@mkdir -p $(dir $@)
	arm-none-eabi-gcc "$<" $(ATON_CFLAGS) -MF"$(@:.o=.d)" -MT"$@" -c -o "$@"

# ---------------------------------------------------------------------------
# 4) Regenerate objects.list from ALL $(OBJS) so the linker sees everything.
#
#    CubeIDE pre-writes objects.list (with only ~17 Eclipse-known entries)
#    BEFORE calling make, so its timestamp is newer than any .o from the
#    previous build.  Without FORCE, make would skip our rule on incremental
#    builds (Run As, second Build, …) and the linker would use the 17-entry
#    list → "undefined reference" for everything.
#
#    FORCE (phony) guarantees this recipe runs every make invocation,
#    overwriting whatever CubeIDE wrote.  $(OBJS) as a prerequisite still
#    ensures all objects are compiled BEFORE the list is written.
# ---------------------------------------------------------------------------
FORCE:
.PHONY: FORCE

objects.list: FORCE $(OBJS) makefile $(OPTIONAL_TOOL_DEPS)
	@echo 'Updating objects list: $(words $(OBJS)) objects'
	$(file > $@)$(foreach obj,$(OBJS),$(file >> $@,$(obj)))
